{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$HOME/.claude/hooks/guard-bash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/py-post-edit.sh\"",
            "timeout": 120,
            "statusMessage": "Running Python edit checks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docker ps --format '{{.Names}}' | grep -q . && echo 'WARNING: containers still running:' && docker ps --format '{{.Names}}' || true"
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/py-stop-gate.sh\"",
            "timeout": 900,
            "statusMessage": "Running Python quality gate"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "be-terse@be-terse": true,
    "shepherd@shepherd": true
  },
  "extraKnownMarketplaces": {
    "spec-driven-framework": {
      "source": {
        "source": "github",
        "repo": "rohaquinlop/spec-driven-framework"
      }
    },
    "be-terse": {
      "source": {
        "source": "github",
        "repo": "rohaquinlop/be-terse"
      }
    },
    "shepherd": {
      "source": {
        "source": "github",
        "repo": "rohaquinlop/shepherd"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-4-6": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}